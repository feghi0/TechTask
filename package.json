{
  "name": "techtask",
  "version": "1.0.0",
  "description": "Gestión privada de proyectos técnicos y entregas escolares — Generación T",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k npm:dev:api npm:dev:web",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && esbuild backend/src/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server/server.js",
    "start": "node dist/server/server.js",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format:check": "prettier --check frontend/src backend/src shared tests",
    "import:sqlite": "tsx scripts/import-sqlite.ts",
    "demo": "tsx scripts/seed-demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "lucide-react": "^1.73.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.21.0"
  }
}
